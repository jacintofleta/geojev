# Get a key at https://console.typesafe.ai
TYPESAFE_API_KEY=

# Production safeguards (optional locally). Add Upstash Redis from the Vercel
# Marketplace and these are set for you (KV_REST_API_URL / KV_REST_API_TOKEN
# also work). Without them, the spend cap, rate limits and cache are off.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Max Jev spend per day (UTC), in USD. Defaults to 10.
DAILY_BUDGET_USD=10
